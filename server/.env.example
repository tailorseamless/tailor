# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Public address of the web app (links in emails are built from it)
APP_URL=http://localhost:5173
# Comma-separated, exact origins
CORS_ORIGINS=http://localhost:5173
# Platform admins: the email addresses (comma-separated) of people who can open the Platform screen and edit any
# business, including the email, currency and time zone its owner cannot change. Each needs an account here and a
# VERIFIED email (Google sign-in counts). Removing an address and restarting takes the access away.
PLATFORM_ADMIN_EMAILS=
# Where businesses reach support: a WhatsApp number, country code first, digits only (e.g. 2348012345678).
# Signed-in people see a "Contact support" link in the account menu. Leave empty to hide it.
SUPPORT_WHATSAPP_NUMBER=
# Two separate lengths of time, each written with a unit: 60d, 12h, 30m, 45s (also "90 minutes").
#
# SESSION_LIFETIME: how long a sign-in lasts, counted from when the person signed in (not their last visit). After
# that the app signs them out and they sign in again. Default 60d.
SESSION_LIFETIME=60d
# ACCESS_TOKEN_LIFETIME: how old the token the app presents may be before the API says "fetch a new one". The app
# does that straight away, behind the scenes, and the person stays signed in. Default and maximum 1h (that is how long
# Firebase's tokens last). Try 10s to watch it happen: the app asks Firebase for a new token about that often.
ACCESS_TOKEN_LIFETIME=1h
# Either way, changing a value and restarting the API applies to everyone straight away.
# fatal | error | warn | info | debug | trace | silent  (default: debug in development, info otherwise)
LOG_LEVEL=

# ── Database (required) ──────────────────────────────────────────────
DATABASE_URL=postgres://postgres:<password>@localhost:5432/tailorflow_dev
DATABASE_SSL=false
# Or, instead of DATABASE_URL, the separate fields hosts like Aiven show (DB_SSL=true stands in for DATABASE_SSL):
# DB_HOST=  DB_PORT=  DB_USER=  DB_PASSWORD=  DB_NAME=  DB_SSL=true
DB_POOL_MAX=10
# Hosted Postgres CA certificate (Aiven): a PEM, a PEM with \n escapes, or base64 of the file.
DATABASE_CA_CERT=

# ── Firebase Authentication ──────────────────────────────────────────
# Required. Must be the same project the web app signs in with.
FIREBASE_PROJECT_ID=tailorflow-dev
# Base64 of the service-account JSON. Required in production; optional locally
# (verifying ID tokens only needs the project id).
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Dev only, e.g. 127.0.0.1:9099. Must be empty in production.
FIREBASE_AUTH_EMULATOR_HOST=

# ── Background jobs ──────────────────────────────────────────────────
# true (default): the API process runs the jobs itself, every minute.
# false: run them from cron instead:  npm --workspace server run jobs
JOBS_IN_PROCESS=true

# ── Files: Cloudinary (optional) ─────────────────────────────────────
# Either the one URL from the Cloudinary console…
CLOUDINARY_URL=
# …or the three values (these win when both are set).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Default tailorflow/dev (tailorflow/prod in production).
CLOUDINARY_FOLDER_ROOT=

# ── Email (optional) ─────────────────────────────────────────────────
# none (default): emails are queued but not sent.
# smtp: send through SMTP.   apps_script: send through a Google Apps Script web app.
EMAIL_PROVIDER=none
# Try the other provider when the chosen one fails (if it is configured).
EMAIL_FALLBACK=true
SMTP_HOST=
SMTP_PORT=587
# true for port 465; false = STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=
# For Gmail, a 16-character app password — never the account password.
SMTP_PASSWORD=
EMAIL_FROM_NAME=Tailor Seamless
# Either a plain address (the sender name is EMAIL_FROM_NAME) or `Name <address>`, which sets both.
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
# Apps Script: the deployment URL ending in /exec (a credential — keep it out of git),
# and the MAIL_TOKEN script property. Script and setup: server/docs/apps-script-mailer.gs
EMAIL_APPS_SCRIPT_URL=
EMAIL_APPS_SCRIPT_TOKEN=
# Check the setup:  npm --workspace server run email:test -- --status

# ── Error monitoring (optional) ──────────────────────────────────────
# Without a DSN nothing is sent anywhere. Only unexpected errors are reported, with no personal data.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# ── Web push (optional) ──────────────────────────────────────────────
# Needs FIREBASE_SERVICE_ACCOUNT_BASE64. false switches push off without removing it.
PUSH_ENABLED=true

# ── AI (optional) ────────────────────────────────────────────────────
# Encrypts the AI provider keys saved in Admin → AI. Without it no key can be saved and AI stays off.
# At least 32 characters: openssl rand -base64 32. Keep it secret and keep it the same: changing it makes
# every saved key unreadable (they must then be saved again).
AI_KEYS_SECRET=
# How long one AI request may take (ms), and the limit for the few very long ones.
AI_REQUEST_TIMEOUT_MS=90000
AI_LONG_REQUEST_TIMEOUT_MS=1200000
