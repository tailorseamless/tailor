{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "TailorFlow API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "jobs": "tsx src/jobs/run.ts",
    "migration:generate": "tsx src/infrastructure/database/migrate.ts generate",
    "migration:run": "tsx src/infrastructure/database/migrate.ts run",
    "migration:revert": "tsx src/infrastructure/database/migrate.ts revert",
    "migration:status": "tsx src/infrastructure/database/migrate.ts status",
    "migration:run:prod": "node dist/infrastructure/database/migrate.js run",
    "email:test": "tsx scripts/emailTest.ts",
    "admin:grant": "tsx scripts/adminGrant.ts"
  },
  "dependencies": {
    "@sentry/node": "^9.47.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
