# Every VITE_* value ends up in the browser — never put a secret here.

# The API base, INCLUDING /api/v1.
VITE_API_URL=http://localhost:4000/api/v1

# Firebase web config: Firebase console → Project settings → Your apps → Web app.
# Must be the same project as the API's FIREBASE_PROJECT_ID.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Push notifications: Project settings → Cloud Messaging → Web Push certificates → key pair.
# Leave empty to turn push off in the app.
VITE_FIREBASE_VAPID_KEY=

# production | staging | development
VITE_ENV=development
